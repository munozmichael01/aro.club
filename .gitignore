/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
.next/
.env.local
.env*.local
supabase/.temp/
.banco-pruebas-fechas.json
# El CLI de Vercel añadió `.env*`, que se lleva por delante .env.example.
# Esa sí se commitea: es la plantilla que dice qué variables hacen falta.
.env
.vercel

# Material de marca y carrouseles: se trabajan aparte, no van al repo.
Aro Club Brand/
carrousel/

# Rastros de los guiones de prueba: qué creó esta máquina en la base, para
# poder deshacerlo. Es estado local de una ejecución, no del proyecto, y
# commitearlo hace que `--borrar` de otra máquina apunte a ids que no son
# suyos. Se coló dos veces en commits ajenos antes de llegar aquí.
.sembrar-mesa.json
.escena.json

# Lo que baja `vercel env pull`: son las variables de produccion enteras, la
# clave de servicio incluida. Los patrones de arriba (`.env`, `.env*.local`)
# NO lo cubren, asi que estaba a un `git add -A` de distancia — y en este
# repo hay otra sesion haciendo `git add -A`.
.env.vercel
.env.production.local

# Los reels: el fuente sí, lo generado no. Cada render son 11 MB de MP4 y
# 1,5 MB de HTML con las fuentes incrustadas, y salen de correr el .mjs.
reel/*.html
reel/*.mp4
reel/fotogramas/

# docs/entrega: lo escrito y las maquetas entran; los originales pesados no.
#
# Los 39 .md son 280 KB y los .dc.html de Design 3,8 MB: eso es el porqué de
# las cosas dentro de seis meses y no se regenera. Los ~200 MB restantes son
# originales de imagen y vídeo, que no se versionan aquí.
docs/entrega/**/Gemini_Generated_Image_*
docs/entrega/**/hf_2*
docs/entrega/polaroids/final/
docs/entrega/polaroids/final-etalonadas/
docs/entrega/polaroids/etalonadas/
docs/entrega/polaroids/seleccion/
docs/entrega/polaroids/_preview/
docs/entrega/polaroids/_rev/
docs/entrega/metraje/
docs/entrega/fotos/fachadas/_preview/
docs/entrega/**/*.mp4

# Fotogramas capturados de la competencia: se recapturan del original.
docs/referencias-reels/

.DS_Store
reel/polaroids/

# El repo es CODIGO. Los vídeos, las referencias de la competencia y las fotos
# de las entregas no arrancan nada ni se despliegan: pesaban 220 MB solo en
# grabaciones de pantalla, y eso lo clona Vercel en cada despliegue.
#
# Lo que SI se queda: `public/` entero —esas fotos las sirve la plataforma— y
# los .md de docs/, que son el porqué de las decisiones.
docs/Vídeos para carrousels/
docs/referencias-carrousels/
docs/competencia/
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.png
docs/**/*.mp4
docs/**/*.MP4
docs/**/*.mov
