# Aro Club - plantilla de variables de entorno.
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://qdydmklrbsdemzvjsldo.supabase.co

# Claves publicas: llegan al navegador, quedan sujetas a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claves secretas: JAMAS deben llegar al navegador ni a un Client Component.
# Solo Server Actions, Route Handlers y jobs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aro Club

# --- Correo -----------------------------------------------------------
# Sin RESEND_API_KEY la cola de correos se lee y se pinta, pero NO se manda
# nada: `/api/cron/correos` responde «no hay remitente» y deja la cola
# intacta. Es lo que permite probar las trece plantillas sin escribirle a
# nadie. Resend exige el dominio verificado con sus registros DNS.
RESEND_API_KEY=

# De quién vienen. El buzón tiene que existir en el dominio verificado.
CORREO_DE=Aro Club <hola@aro.club>

# --- Trabajos programados ---------------------------------------------
# Vercel llama a /api/cron/* con `Authorization: Bearer <CRON_SECRET>`.
# Sin esto las cuatro rutas de cron devuelven 404 y no corre ninguna: ni la
# tasa del BCV, ni el recordatorio, ni el empujon, ni la purga de cedulas.
# Cualquier cadena larga y aleatoria vale.
CRON_SECRET=

# Firma el enlace que deja seguir el alta desde otro dispositivo.
LEAD_TOKEN_SECRET=
