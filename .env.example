# Aro Club - plantilla de variables de entorno.
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se commitea.

NEXT_PUBLIC_SUPABASE_URL=https://diretjmapjcgpjrhqdaz.supabase.co

# Claves publicas: llegan al navegador, quedan sujetas a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claves secretas: JAMAS deben llegar al navegador ni a un Client Component.
# Solo Server Actions, Route Handlers y jobs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aro Club
