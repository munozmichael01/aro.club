{
  "expo": {
    "name": "Aro Club",
    "slug": "aro-club",
    "scheme": "aroclub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "club.aro.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "club.aro.app",
      "adaptiveIcon": {
        "backgroundColor": "#14342A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fuentes/YoungSerif-Regular.ttf",
            "./assets/fuentes/InterTight-Regular.ttf",
            "./assets/fuentes/InterTight-Medium.ttf",
            "./assets/fuentes/InterTight-SemiBold.ttf",
            "./assets/fuentes/InterTight-Bold.ttf"
          ]
        }
      ],
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Aro Club usa la cámara para la foto de tu cédula y una selfie. Con ellas una persona del equipo comprueba que eres tú; nadie más las ve y se borran a los 90 días de aprobarse.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aro Club te deja elegir de tu galería la foto de tu cédula o tu selfie para verificar que eres tú. Solo se sube la foto que elijas.",
          "cameraPermission": "Aro Club usa la cámara para la foto de tu cédula y una selfie. Con ellas una persona del equipo comprueba que eres tú; nadie más las ve y se borran a los 90 días de aprobarse.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 161,
          "resizeMode": "contain",
          "backgroundColor": "#14342A"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "api": "https://aro.club/api",
      "supabaseUrl": "https://qdydmklrbsdemzvjsldo.supabase.co",
      "sitio": "https://aro.club",
      "router": {},
      "eas": {
        "projectId": "51c36ee0-0e19-4c87-bf88-f041afc965a9"
      },
      "google": {
        "webClientId": "",
        "iosClientId": ""
      }
    },
    "owner": "somos.aroclub"
  }
}
