# Lo que EAS NO sube al compilar la app (14-10-2026). Con esto presente,
# EAS deja de leer .gitignore: lo de .gitignore va repetido aquí.
# La app solo necesita app-mobile/ y public/reglas.js (Metro lo lee de ahí).

# --- copiado de .gitignore (raíz) ---
node_modules/
.pnp
.pnp.*
.yarn/*
/coverage
/.next/
/out/
/build
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
.env*.local
.vercel

# --- copiado de app-mobile/.gitignore ---
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*

# --- material de marca, videos y documentos: no son código de la app ---
/docs/
/Social-media/
/Aro Club Brand/
/reel/
/carrousel/
/marca/
/Locales/
/.claude/
/app-mobile/Videos verificacion apple/
/app-mobile/Entregas/
/app-mobile/tienda/
*.zip
*.mp4
*.mov
*.pdf

# --- y lo demás de app-mobile/.gitignore ---
*.tsbuildinfo
/app-mobile/ios
/app-mobile/android
google-services*.json
GoogleService-Info*.plist
